# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase transaction pooler for Vercel runtime (add pgbouncer=true).
DATABASE_URL=
# Direct connection or session pooler for Prisma CLI migrations.
DIRECT_URL=
# Server-only service account. Share only the selected attendance Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
