# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Required for Admin account invitations and the one-time demo bootstrap; never expose it to browser code.
SUPABASE_SECRET_KEY=
# Server-only random token, 16+ characters, for the monthly-report cron route.
CRON_SECRET=
# Public HTTPS origin used in invitation redirects, for example https://your-project.vercel.app.
# Add its /auth/confirm URL to Supabase Auth's allowed redirect URLs.
APP_BASE_URL=
# Set to true after configuring Supabase's Invite user email template as documented in README.md.
AUTH_INVITE_TEMPLATE_READY=false
# Supabase transaction pooler for Vercel runtime (add pgbouncer=true).
DATABASE_URL=
# Optional Supabase Database Settings > SSL Configuration > CA certificate.
# Paste the complete PEM text here or in Vercel as a server-only variable.
SUPABASE_DB_CA_CERT=
# Direct connection or session pooler for Prisma CLI migrations.
DIRECT_URL=
# Four fictional demo accounts. Use distinct email addresses and distinct passwords.
# Keep these values local; do not add them to Vercel or GitHub.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_HOD_EMAIL=
DEMO_HOD_PASSWORD=
# Server-only service account. Share only the selected attendance Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
