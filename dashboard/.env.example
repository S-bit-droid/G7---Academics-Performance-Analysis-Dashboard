# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Used by the one-time demo bootstrap script, never by browser code.
SUPABASE_SECRET_KEY=
# Supabase transaction pooler for Vercel runtime (add pgbouncer=true).
DATABASE_URL=
# Direct connection or session pooler for Prisma CLI migrations.
DIRECT_URL=
# Four fictional demo accounts. Use distinct email addresses and distinct passwords.
# Keep these values local; do not add them to Vercel or GitHub.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_HOD_EMAIL=
DEMO_HOD_PASSWORD=
# Server-only service account. Share only the selected attendance Sheet with this email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
